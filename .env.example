PORT=3001
NEST_SIMULATOR=on
NEST_AI_PROVIDER=mock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# Set a demo caregiver password before using caregiver sign-in in a public deployment.
NEST_CAREGIVER_PASSWORD=
# Staging-only HTTP Basic Auth gate for the app and data APIs. Set both values.
# The Ring link page, authorization-code exchange, signed webhook, and health
# check remain public callbacks and are independently validated by the server.
NEST_STAGING_AUTH_USERNAME=
NEST_STAGING_AUTH_PASSWORD=
RING_ACCESS_TOKEN=
RING_REFRESH_TOKEN=
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_WEBHOOK_HMAC_KEY=
RING_TOKEN_ENCRYPTION_KEY=
# Configure a real HTTPS endpoint before registering Ring staging URLs.
RING_PARTNER_ACCOUNT_IDENTIFIER=
RING_LINK_PASSWORD=
